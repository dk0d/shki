---
// Both starlight-theme-terminal and starlight-versions want the ThemeSelect
// slot (the theme for its toggle, the versions plugin for its switcher), so
// this override composes both — with the switcher UI as a shadcn-svelte
// Select (VersionSelector.svelte) instead of the plugin's native <select>.
import TerminalThemeSelect from "starlight-theme-terminal/overrides/ThemeSelect.astro";
import VersionSelector from "./VersionSelector.svelte";
import versionsFile from "../../versions.json";

const { latest, versions } = versionsFile;

// Every served page lives under a version dir: /next/ tracks main, archived
// releases live at /<X.Y.Z>/, and nginx serves the latest release's archive at
// the site root. Root-built pages exist only as the archive source and are
// pruned from the deployed image.
const allVersions = [{ slug: "next", label: "Next" }, ...versions];

// Same-page URL per version (no i18n, no Astro base, no excluded pages).
const segments = Astro.url.pathname.split("/").filter(Boolean);
const pageVersion = allVersions.find(
  (version) => version.slug === segments[0],
);
const canonicalPath = pageVersion
  ? `/${segments.slice(1).join("/")}${segments.length > 1 ? "/" : ""}`
  : Astro.url.pathname;

const options = allVersions.map((version) => ({
  label:
    version.slug === latest
      ? `${version.label ?? version.slug} (latest)`
      : (version.label ?? version.slug),
  url: `/${version.slug}${canonicalPath === "/" ? "/" : canonicalPath}`,
  // Pages served at the root are the latest release's archive.
  current: (pageVersion?.slug ?? latest) === version.slug,
}));
---

<div class="version-theme-group">
  {
    versions.length > 0 && (
      <VersionSelector client:load options={options} label="Select version" />
    )
  }
  <TerminalThemeSelect />
</div>

<style>
  .version-theme-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
